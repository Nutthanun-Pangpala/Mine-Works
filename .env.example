DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: protects /api/cron/daily (Vercel Cron sends it automatically)
CRON_SECRET=change-me
# Optional: use node-postgres instead of the Neon HTTP driver (local Postgres)
# DB_DRIVER=pg
